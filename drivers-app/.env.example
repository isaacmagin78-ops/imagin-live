# Local defaults. None of these are real secrets.
# Copy to .env if you want to override. The app runs without this file.

PORT=8787
DATABASE_PATH=./data/drivers.sqlite
PUBLIC_BASE_URL=http://localhost:8787

# Pepper for session token hashes. Change before any public host.
# Production (NODE_ENV=production) refuses the placeholder below.
SESSION_SECRET=replace-me-with-a-long-random-string

# Set to 1 behind HTTPS so the session cookie is Secure.
COOKIE_SECURE=0

# How long a sign-in lasts.
SESSION_DAYS=14

# Notifications are an outbox only.
# stub  = write the draft, send nothing (default)
# webhook = still sends nothing unless NOTIFY_ALLOW_NETWORK=1
NOTIFY_MODE=stub
NOTIFY_WEBHOOK_URL=
NOTIFY_ALLOW_NETWORK=0

# Used only by `npm run seed`. Placeholder, not a real password.
SEED_PASSWORD=seed-local-only
